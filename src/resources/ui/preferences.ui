<?xml version="1.0" encoding="UTF-8"?>
<interface>
    <requires lib="gtk" version="4.0" />

    <object class="AdwPreferencesPage" id="preferences-general">
        <property name="title" translatable="yes">General</property>
        <property name="icon-name">preferences-system-symbolic</property>

        <child>
            <object class="AdwPreferencesGroup">
                <property name="title" translatable="yes">General</property>

                <child>
                    <object class="AdwComboRow" id="displaying-items">
                        <property name="title" translatable="yes">Displaying items</property>
                        <property name="model">
                            <object class="GtkStringList">
                            	<!-- MUST USE THE SAME ORDER AS org.gnome.shell.extensions.runcat-victorandreon.DisplayingItems -->
                                <items>
                                    <item translatable="yes">Character and percentage</item>
                                    <item translatable="yes">Percentage only</item>
                                    <item translatable="yes">Character only</item>
                                </items>
                            </object>
                        </property>
                    </object>
                </child>

                <child>
                    <object class="AdwExpanderRow" id="custom-system-monitor-enabled">
                        <property name="show_enable_switch">True</property>
                        <property name="title" translatable="yes">Use a custom system monitor</property>
                        <child>
                            <object class="AdwEntryRow" id="custom-system-monitor-command">
                                <property name="title" translatable="yes">Command</property>
                                <property name="text">gnome-system-monitor -r</property>
                                <property name="show-apply-button">True</property>
                            </object>
                        </child>
                    </object>
                </child>
            </object>
        </child>

        <child>
            <object class="AdwPreferencesGroup">
                <property name="title" translatable="yes">Character</property>

                <child>
                    <object class="AdwSwitchRow" id="invert-speed">
                        <property name="title" translatable="yes">Invert speed</property>
                    </object>
                </child>

                <child>
                    <object class="AdwSpinRow" id="idle-threshold">
                        <property name="title" translatable="yes">Idle threshold</property>
                        <property name="subtitle" translatable="yes">Available when speed is not inverted</property>
                        <property name="adjustment">
                            <object class="GtkAdjustment">
                                <property name="lower">0</property>
                                <property name="upper">100</property>
                                <property name="step-increment">1</property>
                                <property name="page-increment">10</property>
                            </object>
                        </property>
                        <property name="sensitive" bind-source="invert-speed"
                                  bind-property="active" bind-flags="sync-create|invert-boolean" />
                    </object>
                </child>

                <child>
                    <object class="AdwSwitchRow" id="smooth-speed-changes">
                        <property name="title" translatable="yes">Smooth speed changes</property>
                        <property name="subtitle" translatable="yes">Running speed adapts to CPU load gradually</property>
                    </object>
                </child>
            </object>
        </child>

        <child>
            <object class="AdwPreferencesGroup">
                <property name="title" translatable="yes">Reset preferences</property>
                <property name="description" translatable="yes">Reset RunCat preferences to defaults</property>
                <property name="header-suffix">
                    <object class="GtkButton" id="reset">
                        <property name="halign">start</property>
                        <property name="valign">center</property>
                        <child>
                            <object class="GtkBox">
                                <property name="margin-start">20</property>
                                <property name="margin-end">20</property>
                                <property name="margin-top">6</property>
                                <property name="margin-bottom">6</property>
                                <child>
                                    <object class="GtkLabel">
                                        <property name="label" translatable="yes">Reset</property>
                                    </object>
                                </child>
                            </object>
                        </child>
                        <style>
                            <class name="circular" />
                            <class name="destructive-action" />
                        </style>
                    </object>
                </property>
            </object>
        </child>
    </object>

    <object class="AdwPreferencesPage" id="preferences-metrics">
        <property name="title" translatable="yes">Metrics</property>
        <property name="icon-name">utilities-system-monitor-symbolic</property>

        <child>
            <object class="AdwPreferencesGroup">
                <property name="title" translatable="yes">Sampling</property>

                <child>
                    <object class="AdwSpinRow" id="refresh-interval">
                        <property name="title" translatable="yes">Refresh interval</property>
                        <property name="subtitle" translatable="yes">How often metrics are updated, in seconds</property>
                        <property name="adjustment">
                            <object class="GtkAdjustment">
                                <property name="lower">1</property>
                                <property name="upper">10</property>
                                <property name="step-increment">1</property>
                                <property name="page-increment">1</property>
                            </object>
                        </property>
                    </object>
                </child>

                <child>
                    <object class="AdwEntryRow" id="storage-path">
                        <property name="title" translatable="yes">Storage path</property>
                        <property name="show-apply-button">True</property>
                    </object>
                </child>
            </object>
        </child>

        <child>
            <object class="AdwPreferencesGroup">
                <property name="title" translatable="yes">Appearance</property>

                <child>
                    <object class="AdwComboRow" id="dashboard-columns">
                        <property name="title" translatable="yes">Menu layout</property>
                        <property name="subtitle" translatable="yes">Automatic adds columns side by side when the cards don't fit the screen height</property>
                        <property name="model">
                            <object class="GtkStringList">
                                <!-- index = number of columns, 0 = automatic -->
                                <items>
                                    <item translatable="yes">Automatic</item>
                                    <item translatable="yes">1 column</item>
                                    <item translatable="yes">2 columns</item>
                                    <item translatable="yes">3 columns</item>
                                    <item translatable="yes">4 columns</item>
                                </items>
                            </object>
                        </property>
                    </object>
                </child>

                <child>
                    <object class="AdwActionRow" id="chart-color">
                        <property name="title" translatable="yes">Chart color</property>
                        <property name="subtitle" translatable="yes">Charts and bars in the menu</property>
                    </object>
                </child>

                <child>
                    <object class="AdwActionRow" id="dashboard-background-color">
                        <property name="title" translatable="yes">Menu background</property>
                        <property name="subtitle" translatable="yes">Lower the opacity for a more transparent background</property>
                    </object>
                </child>
            </object>
        </child>

        <child>
            <object class="AdwPreferencesGroup">
                <property name="title" translatable="yes">Top bar</property>
                <property name="description" translatable="yes">Metrics displayed next to the character. CPU usage is configured with “Displaying items” on the General page</property>

                <child>
                    <object class="AdwSwitchRow" id="panel-show-temperature">
                        <property name="title" translatable="yes">CPU temperature</property>
                    </object>
                </child>

                <child>
                    <object class="AdwSwitchRow" id="panel-show-memory">
                        <property name="title" translatable="yes">Memory usage</property>
                    </object>
                </child>

                <child>
                    <object class="AdwSwitchRow" id="panel-show-storage">
                        <property name="title" translatable="yes">Storage usage</property>
                    </object>
                </child>

                <child>
                    <object class="AdwSwitchRow" id="panel-show-battery">
                        <property name="title" translatable="yes">Battery level</property>
                        <property name="subtitle" translatable="yes">Hidden when there is no battery</property>
                    </object>
                </child>

                <child>
                    <object class="AdwSwitchRow" id="panel-show-network">
                        <property name="title" translatable="yes">Network speed</property>
                        <property name="subtitle" translatable="yes">Upload and download rates</property>
                    </object>
                </child>
            </object>
        </child>

        <child>
            <object class="AdwPreferencesGroup">
                <property name="title" translatable="yes">Menu dashboard</property>
                <property name="description" translatable="yes">Cards displayed when clicking the character</property>

                <child>
                    <object class="AdwSwitchRow" id="dashboard-show-cpu">
                        <property name="title" translatable="yes">CPU</property>
                    </object>
                </child>

                <child>
                    <object class="AdwSwitchRow" id="dashboard-show-memory">
                        <property name="title" translatable="yes">Memory</property>
                    </object>
                </child>

                <child>
                    <object class="AdwSwitchRow" id="dashboard-show-storage">
                        <property name="title" translatable="yes">Storage</property>
                    </object>
                </child>

                <child>
                    <object class="AdwSwitchRow" id="dashboard-show-battery">
                        <property name="title" translatable="yes">Battery</property>
                        <property name="subtitle" translatable="yes">Hidden when there is no battery</property>
                    </object>
                </child>

                <child>
                    <object class="AdwSwitchRow" id="dashboard-show-network">
                        <property name="title" translatable="yes">Network</property>
                    </object>
                </child>
            </object>
        </child>
    </object>

    <object class="AdwPreferencesPage" id="preferences-custom-metrics">
        <property name="title" translatable="yes">Custom</property>
        <property name="icon-name">document-edit-symbolic</property>

        <child>
            <object class="AdwPreferencesGroup">
                <property name="title" translatable="yes">How it works</property>
                <property name="description" translatable="yes">Any script, cron job or hook (for example a Claude Code status line) can write a small JSON file, and RunCat shows it as a card in the menu, updated as soon as the file changes. Files in the metrics folder are picked up automatically; files elsewhere can be added below.</property>

                <child>
                    <object class="AdwActionRow" id="custom-metrics-open-folder">
                        <property name="title" translatable="yes">Open metrics folder</property>
                        <property name="activatable">True</property>
                        <child type="suffix">
                            <object class="GtkImage">
                                <property name="icon-name">folder-open-symbolic</property>
                            </object>
                        </child>
                    </object>
                </child>

                <child>
                    <object class="AdwActionRow" id="custom-metrics-docs">
                        <property name="title" translatable="yes">File format and examples</property>
                        <property name="subtitle" translatable="yes">Claude Code usage, Claude Code hooks, GPU and more</property>
                        <property name="activatable">True</property>
                        <child type="suffix">
                            <object class="GtkImage">
                                <property name="icon-name">adw-external-link-symbolic</property>
                            </object>
                        </child>
                    </object>
                </child>
            </object>
        </child>

        <child>
            <object class="AdwPreferencesGroup" id="custom-metrics-sources">
                <property name="title" translatable="yes">Sources</property>
                <property name="description" translatable="yes">Choose where each source is displayed: as a card in the menu and/or as a value in the top bar</property>
                <property name="header-suffix">
                    <object class="GtkButton" id="custom-metrics-add">
                        <property name="valign">center</property>
                        <child>
                            <object class="AdwButtonContent">
                                <property name="icon-name">list-add-symbolic</property>
                                <property name="label" translatable="yes">Add file</property>
                            </object>
                        </child>
                        <style>
                            <class name="flat" />
                        </style>
                    </object>
                </property>
            </object>
        </child>
    </object>

    <object class="GtkAboutDialog" id="about-dialog">
        <property name="program-name">GNOME RunCat</property>
        <property name="authors">Sergei Kolesnikov https://kolesnikov.se/</property>
        <property name="artists">Sergei Kolesnikov, Takuto Nakamura</property>
        <property name="comments" translatable="yes">The cat tells you the CPU usage by running speed</property>
        <property name="copyright">© 2020-2026 Sergei Kolesnikov</property>
        <property name="license_type">gpl-3-0</property>
        <property name="website">https://github.com/win0err/gnome-runcat</property>
        <property name="website_label" translatable="yes">Visit RunCat's GitHub page</property>
        <property name="can-focus">False</property>
        <property name="hide-on-close">True</property>
        <property name="modal">True</property>
        <property name="destroy-with-parent">True</property>
    </object>

    <menu id="main-menu">
        <section>
            <item>
                <attribute name="label" translatable="yes">Visit Homepage</attribute>
                <attribute name="action">prefs.homepage</attribute>
            </item>
            <item>
                <attribute name="label" translatable="yes">About RunCat</attribute>
                <attribute name="action">prefs.about</attribute>
            </item>
        </section>
    </menu>

    <object class="GtkMenuButton" id="menu-button">
        <property name="menu-model">main-menu</property>
        <property name="icon-name">open-menu-symbolic</property>
    </object>
</interface>
